# Configuração fictícia. Nunca versionar o .env real.
HOST=127.0.0.1
PORT=8080
# Caminho persistente; padrão: web/data
# MESA3D_DATA_DIR=
# Sem as credenciais abaixo, administração indisponível.
OWNER_EMAIL=
OWNER_PASSWORD=
# Preservar a chave original se já houver credenciais de pagamento cifradas.
MESA3D_ENCRYPTION_KEY=

# Geração no servidor: sempre desligada até validação do host Linux e aceite.
RECONSTRUCTION_ENABLED=false
RECONSTRUCTION_RUNTIME_DIGEST=
MESA3D_PUBLIC_ORIGIN=
# MESA3D_PIPELINE_ROOT=/opt/mesa3d/worker-3d
# MESA3D_PYTHON=/opt/pratoar-runtime/venv/bin/python
# PRATOAR_LAN_RUNTIME_ROOT=/opt/pratoar-runtime
# PRATOAR_SEGMENTATION_WEIGHTS=/opt/pratoar-runtime/models/mobile_sam.pt
# MESA3D_WORKER_ID=server-worker
