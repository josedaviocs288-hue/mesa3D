# Copie para .env. Nunca publique este arquivo nem compartilhe senhas/chaves.
HOST=127.0.0.1
PORT=8080
MESA3D_DATA_DIR=
PUBLIC_BASE_URL=

# Primeira inicialização: cria a conta proprietária. Depois altere a senha pelo painel.
OWNER_EMAIL=
OWNER_PASSWORD=

# Gere com: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
MESA3D_ENCRYPTION_KEY=

# Para um piloto privado: código de convite com pelo menos 12 caracteres.
# O iniciador de teste cria um automaticamente. Não use sua senha de administrador.
PILOT_ACCESS_CODE=

# Mercado Pago: aplicação da plataforma, OAuth e Webhooks.
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_WEBHOOK_SECRET=
MP_OWNER_ACCESS_TOKEN=
# Centavos. Exemplo: 4900 = R$ 49,00. Zero desativa a mensalidade.
PLAN_MONTHLY_CENTS=0

# Opcional: geração por IA de 2 a 4 fotos. A API Meshy requer plano pago.
# Para um scan real em GLB, deixe vazio: upload, calibração e AR funcionam sem API.
MESHY_API_KEY=
